{{ include_css('extensions/publication/styles/publication.css') }}
{% if publications is empty %}
  <div class="yw-alert yw-alert--info">{{ _t('PUBLICATION_NO_EBOOK_FOUND') }}</div>
{% else %}
  <ul class="yw-list-unstyled publication-list">
    {% for publication in publications %}
      <li>
        {% include '@publication/includes/publication.twig' with publication only %}
      </li>
    {% endfor %}
  </ul>
{% endif %}

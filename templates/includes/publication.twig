<article class="yw-publication__show">
  <div class="yw-publication__summary">
    {% if metas['publication-cover-image'] %}
      <img class="yw-publication__cover" alt="" src="{{ metas['publication-cover-image'] }}">
    {% endif %}

    <h3><a href="{{ url({ tag: tag }) }}">{{ metas.publication.title }}</a></h3>

    {% if metas.publication.description %}
      <p>{{ metas.publication.description }}</p>
    {% endif %}
    {% if metas.publication.authors %}
      <p class="yw-publication__authors">{{ metas.publication.authors }}</p>
    {% endif %}

    <p class="yw-text-muted">
      <small>
        {{ _t('PUBLICATION_MODE_' ~ metas['publication-mode']|upper) }},
        {% if metas['publication-mode'] == 'fanzine' %}
          {{ _t('PUBLICATION_FANZINE_LAYOUT_' ~ metas['publication-fanzine']['layout']|replace({'-': '_'})|upper) }}
          <img src="extensions/publication/styles/fanzine-layouts/{{ metas['publication-fanzine']['layout'] }}.svg" alt="" class="fanzine-layout">
        {% else %}
          {{ metas['publication-book']['page-format'] }}
          {{ _t('PUBLICATION_EBOOK_ORIENTATION_' ~ metas['publication-book']['page-orientation']|upper) }}
        {% endif %}
      </small>
    </p>
  </div>

  <div class="yw-publication__actions">
    <a href="{{ url({ handler: 'pdf', tag: tag }) }}" class="yw-btn yw-btn--primary">
      {{ icon('file-type-pdf') }} <span>{{ _t('PUBLICATION_VIEW_PDF') }}</span>
    </a>
    {% if hasWriteAccess %}
      <a href="{{ url({ handler: 'preview', tag: tag }) }}" class="yw-btn">
        {{ icon('eye') }} <span>{{ _t('PUBLICATION_PREVIEW') }}</span>
      </a>
    {% endif %}
    <a href="{{ url({ handler: 'share', tag: tag }) }}" class="yw-btn modalbox">
      {{ icon('share') }} <span>{{ _t('TEMPLATE_SHARE') }}</span>
    </a>
    {% if hasDeleteAccess %}
      <a href="{{ url({ handler: 'deletepage', tag: tag }) }}" class="yw-btn yw-btn--danger link-deletepage modalbox">
        {{ icon('trash') }} <span>{{ _t('TEMPLATE_DELETE') }}</span>
      </a>
    {% endif %}
  </div>
</article>

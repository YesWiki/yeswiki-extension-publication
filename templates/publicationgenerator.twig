{{ include_css('extensions/publication/styles/publication.css') }}
{{ include_javascript('javascripts/vendor/sortablejs/sortable.js') }}
{{ include_javascript('extensions/publication/javascripts/publicationgenerator.js') }}

{% macro item(page, group, selected, readonly) %}
  <li class="yw-list-group__item publication-item{{ page.blank ? ' blank-page' : '' }}" data-group="{{ group }}">
    <span class="publication-item__handle movable"{{ selected ? '' : ' hidden' }}>{{ icon('arrows-vertical') }}</span>
    {% if not page.blank %}
      <a class="yw-btn yw-btn--sm view-page-item modalbox" data-size="modal-lg" title="{{ _t('PUBLICATION_SEE_PAGE') }} {{ page.tag }}" href="{{ url({ handler: 'html', tag: page.tag }) }}">
        {{ icon('eye') }}
      </a>
    {% endif %}
    <input type="hidden" name="page[]" value="{{ page.value|default(page.tag) }}"{{ selected ? '' : ' disabled' }}>
    <span class="page-label">{{ page.label }}</span>
    {% if not readonly %}
      <button type="button" class="yw-btn yw-btn--sm yw-btn--success select-page-item" title="{{ _t('PUBLICATION_SELECT_PAGE') }} {{ page.label }} {{ _t('PUBLICATION_FOR_THE_EBOOK') }}"{{ selected ? ' hidden' : '' }}>
        {{ icon('plus') }}
      </button>
      <button type="button" class="yw-btn yw-btn--sm yw-btn--danger remove-page-item" title="{{ _t('PUBLICATION_DELETE_PAGE') }} {{ page.label }} {{ _t('PUBLICATION_FROM_THE_EBOOK') }}"{{ selected ? '' : ' hidden' }}>
        {{ icon('trash') }}
      </button>
    {% endif %}
  </li>
{% endmacro %}
{% import _self as publication %}

{% for message in messages %}
  <div class="yw-alert yw-alert--{{ message.type }}">{{ message.message|raw }}</div>
{% endfor %}

<div class="publication-generator">
  <section class="publication-generator__available export-table-container">
    <h3>{{ _t('PUBLICATION_AVAILABLE_PAGES') }}</h3>
    <div class="publication-generator__filter">
      {{ icon('filter') }}
      <input class="yw-input" type="search" id="publication-filter" placeholder="{{ _t('PUBLICATION_FILTER_PAGES') }}" aria-label="{{ _t('PUBLICATION_FILTER_PAGES') }}">
    </div>
    <p id="publication-filter-count" class="yw-text-muted" aria-live="polite" data-label="{{ _t('PUBLICATION_PAGE_COUNT') }}"></p>

    {% if chapterCoverPages is not empty and areParamsReadonly != true %}
      <section class="page-groups" data-group="chapters">
        <h4>{{ _t('PUBLICATION_CHAPTERS') }}</h4>
        <ul class="yw-list-group list-entries-to-export"></ul>
      </section>
    {% endif %}

    {% for nb, group in groups %}
      <section class="page-groups" data-group="{{ nb }}">
        <h4>
          <span>{{ group.name }}</span>
          <button type="button" class="yw-btn yw-btn--sm yw-btn--success select-all" title="{{ _t('PUBLICATION_ADD_ALL') }}">
            {{ icon('plus') }} <span>{{ _t('PUBLICATION_ADD_ALL') }}</span>
          </button>
        </h4>
        <ul class="yw-list-group list-entries-to-export">
          {% for page in group.items %}
            {{ publication.item(page, nb, false, false) }}
          {% else %}
            <li class="yw-list-group__item yw-text-muted">{{ _t('PUBLICATION_NOTHING_TO_ADD') }}</li>
          {% endfor %}
        </ul>
      </section>
    {% endfor %}
  </section>

  <section class="publication-generator__selection">
    <div class="publication-generator__heading">
      <h3>{{ _t('PUBLICATION_YOUR') }} {{ name }}</h3>
      <button type="button" class="yw-btn yw-btn--sm yw-btn--primary page-break" data-label="{{ _t('PUBLICATION_BLANK_PAGE') }}" title="{{ _t('PUBLICATION_INSERT_BLANK_PAGE') }}">
        {{ icon('plus') }} <span>{{ _t('PUBLICATION_INSERT_BLANK_PAGE') }}</span>
      </button>
    </div>

    <form class="export-table-form" method="post" action="{{ url }}">
      {% if publicationStart is not empty %}
        <ul class="yw-list-group publication-bookend">
          <li class="yw-list-group__item yw-list-group__item--active">
            <a class="yw-btn yw-btn--sm view-page-item modalbox" data-size="modal-lg" title="{{ _t('PUBLICATION_SEE_PAGE') }} {{ publicationStart.tag }}" href="{{ url({ handler: 'html', tag: publicationStart.tag }) }}">{{ icon('eye') }}</a>
            <input type="hidden" name="page[]" value="{{ publicationStart.tag }}?type=publication-start">
            <span class="page-label">{{ _t('PUBLICATION_START_PAGE') }}</span>
            <span class="page-label-suffix">({{ publicationStart.tag }})</span>
          </li>
        </ul>
      {% endif %}

      <ul id="publication-selection-container" class="yw-list-group" data-empty="{{ _t('PUBLICATION_SELECTION_EMPTY') }}">
        {% if chapterCoverPages is not empty %}
          {% for tag, page in chapterCoverPages %}
            {{ publication.item({tag: tag, label: tag, value: tag ~ '?class=publication-chapter'}, 'chapters', true, areParamsReadonly) }}
          {% endfor %}
        {% else %}
          {% for page in selectedPages %}
            {{ publication.item(page, page.blank ? 'blank' : 'selected', true, false) }}
          {% endfor %}
        {% endif %}
      </ul>

      {% if publicationEnd is not empty %}
        <ul class="yw-list-group publication-bookend">
          <li class="yw-list-group__item yw-list-group__item--active">
            <a class="yw-btn yw-btn--sm view-page-item modalbox" data-size="modal-lg" title="{{ _t('PUBLICATION_SEE_PAGE') }} {{ publicationEnd.tag }}" href="{{ url({ handler: 'html', tag: publicationEnd.tag }) }}">{{ icon('eye') }}</a>
            <input type="hidden" name="page[]" value="{{ publicationEnd.tag }}?type=publication-end">
            <span class="page-label">{{ _t('PUBLICATION_END_PAGE') }}</span>
            <span class="page-label-suffix">({{ publicationEnd.tag }})</span>
          </li>
        </ul>
      {% endif %}

      <div class="yw-form-group">
        <label for="publication-title" class="yw-form-label">{{ _t('PUBLICATION_EBOOK_TITLE') }}<span aria-label="{{ _t('PUBLICATION_MANDATORY_FIELD') }}">*</span></label>
        <input {{ areParamsReadonly ? 'readonly' }} class="yw-input" type="text" required placeholder="{{ _t('PUBLICATION_EBOOK_TITLE') }}" id="publication-title" name="publication[title]" value="{{ metadatas.publication.title }}">
      </div>

      <div class="yw-form-group">
        <label for="publication-description" class="yw-form-label">{{ _t('PUBLICATION_EBOOK_DESC') }}</label>
        <textarea {{ areParamsReadonly ? 'readonly' }} class="yw-input" placeholder="{{ _t('PUBLICATION_EBOOK_DESC') }}" id="publication-description" name="publication[description]">{{ metadatas.publication.description }}</textarea>
      </div>

      <div class="yw-form-group">
        <label for="publication-authors" class="yw-form-label">{{ _t('PUBLICATION_EBOOK_AUTHOR') }}</label>
        <input {{ areParamsReadonly ? 'readonly' }} class="yw-input" type="text" placeholder="{{ _t('PUBLICATION_EXAMPLE_AUTHOR') }}" id="publication-authors" name="publication[authors]" value="{{ metadatas.publication.authors }}">
      </div>

      {% if outputFormat == 'ebook' %}
        <div class="yw-form-group">
          <label for="publication-cover-image" class="yw-form-label">{{ _t('PUBLICATION_EBOOK_COVER_IMAGE') }}</label>
          <input {{ areParamsReadonly ? 'readonly' }} class="yw-input" type="text" placeholder="https://" id="publication-cover-image" name="publication-cover-image" value="{{ metadatas['publication-cover-image'] }}">
        </div>

        <div class="yw-form-group publication-check">
          <input type="checkbox" name="publication-cover-page" value="1" {{ publicationStart ? 'disabled' }} {{ metadatas['publication-cover-page'] == '1' ? 'checked' }} id="publication-cover-page">
          <label for="publication-cover-page">{{ _t('PUBLICATION_EBOOK_COVER_PAGE') }}</label>
          <small class="yw-text-muted">{{ publicationStart ? _t('PUBLICATION_EBOOK_COVER_PAGE_WITH_PUBLICATION_START_HELP') : _t('PUBLICATION_EBOOK_COVER_PAGE_HELP') }}</small>
        </div>

        <fieldset class="yw-form-group publication-modes">
          <legend class="yw-form-label">{{ _t('PUBLICATION_MODE') }}</legend>
          <label class="yw-radio-inline">
            <input type="radio" name="publication-mode" value="book" {{ metadatas['publication-mode'] != 'fanzine' ? 'checked' }}>
            <span>{{ _t('PUBLICATION_MODE_BOOK') }}</span>
          </label>
          <label class="yw-radio-inline">
            <input type="radio" name="publication-mode" value="fanzine" {{ metadatas['publication-mode'] == 'fanzine' ? 'checked' }}>
            <span>{{ _t('PUBLICATION_MODE_FANZINE') }}</span>
          </label>
        </fieldset>

        <details class="publication-options options-book"{{ metadatas['publication-mode'] == 'fanzine' ? ' hidden' }}>
          <summary>{{ _t('PUBLICATION_MORE_OPTIONS') }}</summary>

          <div class="yw-form-group publication-check">
            <input type="checkbox" name="publication-book[print-fold]" value="1" id="publication-book-fold" {{ metadatas['publication-book']['print-fold'] == '1' ? 'checked' }}>
            <label for="publication-book-fold">{{ _t('PUBLICATION_EBOOK_FOLD') }}</label>
            <small class="yw-text-muted">{{ _t('PUBLICATION_EBOOK_FOLD_HELP') }}</small>
          </div>
          <div class="yw-form-group publication-check">
            <input type="checkbox" name="publication-book[print-marks]" value="1" id="publication-print-marks" {{ metadatas['publication-book']['print-marks'] == '1' ? 'checked' }}>
            <label for="publication-print-marks">{{ _t('PUBLICATION_EBOOK_DISPLAY_PRINT_MARKS') }}</label>
            <small class="yw-text-muted">{{ _t('PUBLICATION_EBOOK_DISPLAY_PRINT_MARKS_HELP') }}</small>
          </div>

          <div class="publication-options__pair">
            <div class="yw-form-group">
              <label for="publication-page-format" class="yw-form-label">{{ _t('PUBLICATION_EBOOK_FORMAT') }}</label>
              <select class="yw-input" name="publication-book[page-format]" id="publication-page-format">
                {% for format in ['A3', 'A4', 'A5'] %}
                  <option value="{{ format }}" {{ metadatas['publication-book']['page-format'] == format ? 'selected' }}>{{ format }}</option>
                {% endfor %}
              </select>
            </div>
            <div class="yw-form-group">
              <label for="publication-page-orientation" class="yw-form-label">{{ _t('PUBLICATION_EBOOK_ORIENTATION') }}</label>
              <select class="yw-input" name="publication-book[page-orientation]" id="publication-page-orientation">
                <option value="portrait" {{ metadatas['publication-book']['page-orientation'] == 'portrait' ? 'selected' }}>{{ _t('PUBLICATION_EBOOK_ORIENTATION_PORTRAIT') }}</option>
                <option value="landscape" {{ metadatas['publication-book']['page-orientation'] == 'landscape' ? 'selected' }}>{{ _t('PUBLICATION_EBOOK_ORIENTATION_LANDSCAPE') }}</option>
              </select>
            </div>
          </div>

          <fieldset class="yw-form-group">
            <legend class="yw-form-label">{{ _t('PUBLICATION_PAGINATION_POSITION') }}</legend>
            {% for position, label in {'none': 'PUBLICATION_PAGINATION_NONE', 'bottom-center': 'PUBLICATION_PAGINATION_BOTTOM_CENTER', 'bottom-sides': 'PUBLICATION_PAGINATION_BOTTOM_SIDES'} %}
              <label class="yw-radio-inline">
                <input type="radio" name="publication-book[pagination]" value="{{ position }}" {{ metadatas['publication-book']['pagination'] == position ? 'checked' }}>
                <span>{{ _t(label) }}</span>
              </label>
            {% endfor %}
          </fieldset>
        </details>

        <details class="publication-options options-fanzine" open{{ metadatas['publication-mode'] != 'fanzine' ? ' hidden' }}>
          <summary>{{ _t('PUBLICATION_MORE_OPTIONS') }}</summary>
          <fieldset class="yw-form-group publication-fanzine-layouts">
            <legend class="yw-form-label">{{ _t('PUBLICATION_FANZINE_LAYOUT') }}</legend>
            {% for layout in ['single-page', 'recto-folio'] %}
              {% set key = layout|replace({'-': '_'})|upper %}
              <label class="publication-pill">
                <img src="extensions/publication/styles/fanzine-layouts/{{ layout }}.svg" alt="">
                <input type="radio" name="publication-fanzine[layout]" value="{{ layout }}" {{ metadatas['publication-fanzine']['layout'] == layout ? 'checked' }}>
                <span>{{ _t('PUBLICATION_FANZINE_LAYOUT_' ~ key) }}</span>
                <small class="yw-text-muted">{{ _t('PUBLICATION_FANZINE_LAYOUT_' ~ key ~ '_HELP') }}</small>
              </label>
            {% endfor %}
          </fieldset>
        </details>
      {% endif %}

      <input type="hidden" value="{{ outputFormat }}" name="outputformat">
      <button type="submit" class="yw-btn yw-btn--primary yw-btn--lg yw-btn--block">{{ _t('PUBLICATION_GENERATE') }} {{ name }}</button>
    </form>
  </section>
</div>

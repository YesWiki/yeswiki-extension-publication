{
    "name": "yeswiki/extension-publication",
    "type": "yeswiki-extension",
    "description": "Crée un pdf à partir d'une sélection de pages YesWiki.",
    "license": "GPL-3.0",
    "minimum-stability": "stable",
    "scripts": {
        "test": "exit 0",
        "update-force-silent": "@composer update --ignore-platform-req=ext-sockets"
    },
    "require": {
        "php": "^8.2",
        "ext-sockets": "*",
        "chrome-php/chrome": "^1"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
